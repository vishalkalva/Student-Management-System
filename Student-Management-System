# ================================
# Student Management System (Version 1)
# ================================

# List to store all student records
sms = []


# -------------------------------
# Search Student
# -------------------------------
def search_student():
    found = False
    entered_id = int(input("Enter student ID: "))

    # Search for the student by ID
    for student in sms:
        if student["id"] == entered_id:
            print(student)
            found = True
            break

    # If no student is found
    if not found:
        print("Student not found")


# -------------------------------
# Update Student
# -------------------------------
def update_student():
    found = False
    entered_id = int(input("Enter student ID to update: "))

    # Search for the student by ID
    for student in sms:
        if student["id"] == entered_id:

            # Update student details
            student["student"] = input("Enter new student name: ")
            student["age"] = int(input("Enter new student age: "))
            student["marks"] = int(input("Enter new student marks: "))

            print("Student updated successfully")
            found = True
            break

    # If student ID does not exist
    if not found:
        print("Student not found")


# -------------------------------
# Delete Student
# -------------------------------
def delete_student():
    found = False
    entered_id = int(input("Enter student ID to delete: "))

    # Search for the student by ID
    for student in sms:
        if student["id"] == entered_id:

            # Remove student from the list
            sms.remove(student)
            print("Student deleted successfully")
            found = True
            break

    # If student ID does not exist
    if not found:
        print("Student not found")


# ================================
# Main Menu
# ================================
while True:

    # Display menu
    print("\n1. Add Student")
    print("2. View Students")
    print("3. Search Student")
    print("4. Update Student")
    print("5. Delete Student")
    print("6. Exit")

    choice = int(input("Enter your choice: "))

    # -------------------------------
    # Add Student
    # -------------------------------
    if choice == 1:

        student_id = int(input("Enter student ID: "))
        student_name = input("Enter student name: ")
        age = int(input("Enter student age: "))
        marks = int(input("Enter student marks: "))

        # Create a dictionary for one student
        record = {
            "id": student_id,
            "student": student_name,
            "age": age,
            "marks": marks
        }

        # Add student to the list
        sms.append(record)

        print("Student added successfully!")

    # -------------------------------
    # View Students
    # -------------------------------
    elif choice == 2:

        if not sms:
            print("No student records found.")
        else:
            print("\nStudent Records")
            for student in sms:
                print(student)

    # -------------------------------
    # Search Student
    # -------------------------------
    elif choice == 3:
        search_student()

    # -------------------------------
    # Update Student
    # -------------------------------
    elif choice == 4:
        update_student()

    # -------------------------------
    # Delete Student
    # -------------------------------
    elif choice == 5:
        delete_student()

    # -------------------------------
    # Exit Program
    # -------------------------------
    elif choice == 6:
        print("Thank you for using Student Management System!")
        break

    # -------------------------------
    # Invalid Choice
    # -------------------------------
    else:
        print("Invalid choice! Please enter a number between 1 and 6.")
